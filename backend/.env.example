
PORT=3000
TRUST_PROXY=false
ALLOWED_ORIGINS=http://localhost:3000

# Supabase Session Pooler connection string
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@YOUR_POOLER_HOST:5432/postgres?sslmode=require

# Supabase project settings
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_key

# JWT signing secret
SUPABASE_JWT_SECRET=your_jwt_signing_secret

# Authentication rate-limit secret (at least 32 bytes)
AUTH_RATE_LIMIT_SECRET=your_random_secret_at_least_32_bytes

# Google Calendar OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://YOUR_BACKEND_DOMAIN/api/calendar/callback
GOOGLE_CALENDAR_ENCRYPTION_KEY=your_64_character_hex_encryption_key
